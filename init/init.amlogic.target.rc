on fs
    wait /dev/block/platform/ffe07000.emmc/by-name/factory
    mkdir /mnt/vendor/factory 0770 system system
    mount vfat /dev/block/platform/ffe07000.emmc/by-name/factory /mnt/vendor/factory noatime nodiratime nosuid nodev noexec dmask=0022,context=u:object_r:factory_file:s0
